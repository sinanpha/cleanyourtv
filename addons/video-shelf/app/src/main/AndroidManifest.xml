<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Reads the home screen channels other apps publish (TvContract preview programs and Watch Next).
         A runtime permission: the screen asks for it, or `pm grant` it from a shell (docs/watch-next.md). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- The video thumbnails in those channels are https:// URLs (i.ytimg.com for SmartTube). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): the app that publishes the rows, so a tap can open it. -->
    <queries>
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".ShelfActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Clean Your TV module card (docs/specs/card.md): the tile shows as "Video Shelf" once the owner says Show. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- The rows and pictures for the launcher's video row (home_videos_authority). Exported, but it answers only
             the packages in shelf_readers (options.xml): everyone else gets a SecurityException. -->
        <provider
            android:name=".ShelfProvider"
            android:authorities="io.github.fyting.videoshelf.shelf"
            android:exported="true" />
    </application>
</manifest>
